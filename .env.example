# Скопируйте в .env и при необходимости измените значения.

# --- Фронтенд (CRA) ---
HOST=127.0.0.1
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
# Адрес API задаёт команда, эта строка не используется при npm start / npm run build:
#   npm start            локальный API
#   npm run start:pages  тот же API, что у GitHub Pages
#   npm run dev          API и фронтенд, локальный API
#   npm run dev:pages    API и фронтенд, API GitHub Pages
REACT_APP_API_URL=http://127.0.0.1:3001/api/1.0/

# --- API ---
API_PORT=3001
# Разрешённые источники запросов (CORS и проверка Origin), через запятую
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SESSION_TTL_HOURS=24
SESSION_REMEMBER_DAYS=7

# --- PostgreSQL ---
PG_BIN=C:\Program Files\PostgreSQL\18\bin
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=social
DB_PASSWORD=social
DB_NAME=social

# Тестовый аккаунт (создаётся только в пустой базе)
SEED_EMAIL=nadya@mail.com
SEED_PASSWORD=12345

SMTP_HOST=smtp-host.example.com
SMTP_PORT=587
SMTP_USER=smtp-user@example.com
SMTP_PASS=smtp-password
MAIL_FROM=smtp-verified-user@example.com

# Jamendo client id from https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=